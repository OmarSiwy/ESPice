`ifdef _4_PORTS_CONNECTED_
        if ( COSUBNODE == 1 ) begin
            $error(" *** Fatal(HiSIM_HV:%M): COSUBNODE = 1 but terminal 'sub' is not connected.\n" );
            //$finish(0);
        end
`else
`ifdef _5_PORTS_CONNECTED_
            if ($port_connected(sub) == 0) begin // 4 nodes
                if ( COSUBNODE == 1 )  begin
                    $error(" *** Fatal(HiSIM_HV:%M): 'sub' is not connected but COSUBNODE = 1.\n" );
                    //$finish(0);
                end
            end
`else
            //   _6_PORTS_CONNECTED_
            if ($port_connected(temp) == 1) begin
                if ( COSUBNODE == 0 ) begin
                    $error(" *** Fatal(HiSIM_HV:%M): 6 nodes are connected but COSUBNODE = 0.\n" );
                    //$finish(0);
                end
            end
            else begin
                if ($port_connected(sub) == 0) begin // 4 nodes
                    if ( COSUBNODE == 1 )  begin
                        $error(" *** Fatal(HiSIM_HV:%M): 'sub' is not connected but COSUBNODE = 1.\n" );
                        //$finish(0);
                    end
                end
            end
`endif
        if (COSUBNODE == 0) begin
            V(sub,temp) <+ 0.0;
        end
`endif

