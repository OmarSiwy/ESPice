    `BPRnb( TRAPN      , 1.0        , "-"                            , "trap charge contribution to Eeff  ")
    `BPRnb( TRAPP      , 1.0        , "-"                            , "BTI trap charge contribution to Eeff")
    /////////////// Parameter for HC model //////////////////
    `BPRnb( TRAPGC0    , 1.0E30    , "cm^-3eV^-1"                    , "coefficient of deep trap ")
