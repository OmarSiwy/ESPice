.{
    .name = .espice,
    .version = "0.1.0",
    .fingerprint = 0x8b858d53fd1540a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // VerA is a pinned git+URL, so a checkout builds on its own; an edit
        // in a sibling `../VerA` does not reach this build until the pin moves.
        // Gompute is co-developed and points at the sibling `../Gompute`
        // working tree (last pinned: 67f1983). Worktrees under
        // `.claude/worktrees/` resolve it through a `Gompute` symlink there.
        // Restore a git pin before publishing this repo.

        // The Verilog-A / Verilog compiler, and the `contract` its generated
        // devices import.
        .vera = .{
            .url = "git+https://github.com/OmarSiwy/VerA#c964f64433ab7f91715ba995f821a12144037d29",
            .hash = "vera-0.9.0-fzAu7JrBbAFtS7BM73qDB5ciyYgf7erWs4Rmjlt-AQ66",
        },
        // The GPU runtime, plus `gompute.math`: every generated device routes
        // its transcendentals through it, so it sits on the hottest path in
        // the simulator.
        .gompute = .{ .path = "../Gompute" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "models",
        "include",
        "tests",
        "docs",
    },
}
