        .vera = .{ .path = "../VerA" },
        // The GPU runtime. Pinned to a published commit: the stream, pinned-host
        // and device-fill surface `src/gpu_context.zig` needs now lives upstream.
        .gompute = .{
            .url = "git+https://github.com/OmarSiwy/Gompute.git#e928f1c5fab955672426887076b9fa7b9547025a",
            .hash = "gompute-1.0.0-YJVc1s0WBAB517olDJ-2u7sbXhSg6Y2Le7svV24bV5Bp",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "docs",
        "benchmark",
    },
}
