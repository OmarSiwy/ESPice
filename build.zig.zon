.{
    .name = .espice,
    .version = "0.1.0",
    .fingerprint = 0x8b858d53fd1540a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .benchmark = .{ .path = "benchmark" },
        // The Verilog-A / Verilog compiler, and the `contract` its generated
        // devices import. A path dep while both trees move together; swap to a
        // git+URL with a pinned hash once VerA stabilizes.
        .vera = .{ .path = "../VerA" },
        // The GPU runtime — and `gompute.math`, which every generated device's
        // transcendentals route through, so it sits on the hottest path in the
        // simulator and moves with this tree while that path is being worked.
        //
        // A path dep, like `vera` above, for exactly that reason: under the
        // git+URL pin the build resolved to a content-addressed copy under
        // `zig-pkg/`, so an edit in `../gompute` silently did nothing — the
        // sibling checkout looked live and was not. `../gompute` sits on the
        // commit that pin named (e928f1c), so this changes no code, only which
        // copy is authoritative. Swap back to a pinned git+URL once the math
        // work lands upstream.
        .gompute = .{ .path = "../gompute" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "docs",
        "benchmark",
    },
}
