.{
    .name = .espice,
    .version = "0.1.0",
    .fingerprint = 0x8b858d53fd1540a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Both deps are pinned git+URLs, so a checkout of this repo alone
        // builds. The cost, and it is a real one: the build resolves to a
        // content-addressed copy under the global cache, so an edit in a
        // sibling `../VerA` or `../Gompute` working tree does NOT reach this
        // build. While co-developing either one, point the dep back at
        // `.{ .path = "../VerA" }` locally and restore the pin before pushing.

        // The Verilog-A / Verilog compiler, and the `contract` its generated
        // devices import.
        .vera = .{
            .url = "git+https://github.com/OmarSiwy/VerA#e73cbb946625cba61f4462219c43226ab9bee34e",
            .hash = "vera-0.9.0-fzAu7IGghgHWPkGE1cZ4G8uArMP4GqZM2dg64U91oktd",
        },
        // The GPU runtime, plus `gompute.math`: every generated device routes
        // its transcendentals through it, so it sits on the hottest path in
        // the simulator.
        .gompute = .{
            .url = "git+https://github.com/OmarSiwy/Gompute#67f1983b2741275765e45124ff83235ed5832432",
            .hash = "gompute-1.0.0-YJVc1tJmBgDAQL6u0F8AQHejCpSxtLB5Rk75ResEwGeh",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "models",
        "include",
        "tests",
        "docs",
    },
}
