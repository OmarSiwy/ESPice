Diode full I-V characteristic: forward + reverse sweep

// Hand translation of ../circuit.sp, line for line:
//
//   V1 anode 0 DC 0                              ->  v1 (anode 0) v dc=0
//   D1 anode 0 DMOD                              ->  d1 (anode 0) dmod
//   .model DMOD D(IS=1e-14 N=1 RS=10 BV=100 ...) ->  model dmod sp_diode (...)
//   .dc V1 -5 1 0.005                            ->  sweep ... points=1200
//
// `spice/diode.osdi` is VACASK's build of the SPICE diode — the same Shockley
// model with the same parameter NAMES ngspice's `.model D` takes, which is why
// the card transcribes with no reinterpretation. VACASK's own `diode.osdi` is
// a different model and would make any disagreement unreadable.
//
// 1201 points over -5..1 V: `points` counts intervals (see dc_sweep/vin_sweep).

ground 0

load "resistor.osdi"
load "spice/diode.osdi"

model r resistor
model v vsource
model dmod sp_diode ( is=1e-14 n=1 rs=10 bv=100 ibv=1e-10 )

v1 (anode 0) v dc=0
d1 (anode 0) dmod

control
  options rawfile="binary"
  sweep vsweep instance="v1" parameter="dc" from=-5 to=1 mode="lin" points=1200
    analysis dc1 op
endc
