            "atol": 2e-05,
            "values": [
              0,
              0.75,
              0,
              -0.75,
              0,
              0
            ]
          }
        },
        "axis": {
          "name": "time",
          "values": [
            0.001,
            0.00125,
            0.0015,
            0.00175,
            0.002,
            0.003
          ],
          "rtol": 1e-09,
          "atol": 1e-15
        }
      }
    ],
    "checks": [
      {
        "kind": "axis_bounds",
        "plot": "Transient Analysis",
        "axis": "time",
        "minimum": 0.001,
        "maximum": 0.003
      }
    ],
    "finite_values_required": true,
    "all_requested_analyses_must_complete": true
  },
