{
  "schema_version": 1,
  "analysis": "tran",
  "purpose": "TSTART suppresses output without restarting circuit history",
  "oracle": {
    "kind": "analytic",
    "derivation": "Vout=.75*sin(2*pi*1000*t) for t>=1ms. No reported time may precede TSTART."
